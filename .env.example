# ==============================================================================
# Nebron Polyrepo Infrastructure Environment Configuration (.env.example)
#
# NOTE: Default credentials and secrets provided here are intended STRICTLY for
# local development. Production deployments must override all passwords, secrets,
# keys, and domain origins via secure secret injection (e.g. Vault, K8s Secrets).
# ==============================================================================

# Application environment mode (development | production | test)
NODE_ENV=development
INTERNAL_TOKEN=dev-internal-token-change-me

# ------------------------------------------------------------------------------
# MongoDB Configuration
# ------------------------------------------------------------------------------
# Root credentials used for initial database administration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=adminpassword

# ------------------------------------------------------------------------------
# MinIO Object Storage (Dev substitute for Cloudflare R2)
# ------------------------------------------------------------------------------
# Root access key ID for MinIO administrative operations and S3 clients
MINIO_ROOT_USER=minioadmin
# Root secret access key for MinIO administrative operations and S3 clients
MINIO_ROOT_PASSWORD=minioadmin
# Target default storage bucket for avatars, media, and platform assets
R2_BUCKET=nebron-media

# ------------------------------------------------------------------------------
# LiveKit WebRTC Server
# ------------------------------------------------------------------------------
# Developer API key for LiveKit control plane and room token creation
LIVEKIT_API_KEY=devkey
# Developer API secret for signing LiveKit join tokens
LIVEKIT_API_SECRET=secret

# ------------------------------------------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------------------------------------------
# Time-To-Live in seconds for RS256 access tokens issued by auth-service (default: 15 mins)
JWT_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# CORS & Network Ingress
# ------------------------------------------------------------------------------
# Comma-separated origins allowed to make browser-based cross-origin API requests
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
